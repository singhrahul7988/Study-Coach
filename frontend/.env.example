# Copy this file to .env.local and fill in your project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Create this as a private bucket in Supabase Storage.
SUPABASE_STORAGE_BUCKET=student-pdfs

# Server-only Postgres connection for future database migrations.
DATABASE_URL=

# Server-only Gemini settings for document analysis and practice questions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
